{{!< default}}

<div class="auth-page">
  <div class="auth-card">

    <div class="auth-logo">
      <div class="auth-logo-name">{{@site.title}}<span>.</span></div>
      <div class="auth-logo-tagline">A family story, written together</div>
    </div>

    <h2 class="auth-title">Sign in to read</h2>
    <p class="auth-subtitle">Enter your email and we'll send a magic link. No password needed.</p>

    <div class="gh-portal-trigger">
      <a href="/#/portal/signin" class="btn-primary" style="width:100%;justify-content:center;display:flex;">
        Send Magic Link →
      </a>
    </div>

    <a href="/write" class="auth-writer-link">Writers: go to <span>/write →</span></a>

  </div>
</div>

{{!< default}}
{{#post}}
<article class="gh-article {{post_class}}">

  <header class="post-header fade-up">
    {{#primary_tag}}
      <a class="post-header-tag" href="{{url}}">{{name}}</a>
    {{/primary_tag}}

    <h1 class="post-header-title">{{title}}</h1>

    <div class="post-header-meta">
      {{#primary_author}}
        <div class="post-author">
          {{#if profile_image}}
            <img src="{{img_url profile_image size="xs"}}" alt="{{name}}">
          {{else}}
            <div class="hero-author-avatar-placeholder">{{name.[0]}}</div>
          {{/if}}
          <div class="post-author-info">
            <div class="post-author-name">{{name}}</div>
            <div class="post-author-date">
              <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="MMMM D, YYYY"}}</time>
            </div>
          </div>
        </div>
      {{/primary_author}}
      <span class="post-read-time">{{reading_time}}</span>
    </div>
  </header>

  {{#if feature_image}}
    <div class="post-feature-image fade-up">
      <img
        src="{{img_url feature_image size="l"}}"
        srcset="
          {{img_url feature_image size="s"}} 300w,
          {{img_url feature_image size="m"}} 600w,
          {{img_url feature_image size="l"}} 1000w,
          {{img_url feature_image size="xl"}} 2000w
        "
        sizes="(max-width: 1100px) 100vw, 1100px"
        alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
      >
    </div>
  {{/if}}

  {{#if access}}
    <section class="post-content gh-content fade-up">
      {{content}}
    </section>

    {{#if tags}}
      <div class="post-tags">
        {{#foreach tags}}
          <a class="post-tag" href="{{url}}">#{{name}}</a>
        {{/foreach}}
      </div>
    {{/if}}

    {{#primary_author}}
      <div class="author-box fade-up">
        <div class="author-box-inner">
          {{#if profile_image}}
            <img class="author-box-avatar" src="{{img_url profile_image size="s"}}" alt="{{name}}">
          {{else}}
            <div class="author-box-avatar-placeholder">{{name.[0]}}</div>
          {{/if}}
          <div>
            <div class="author-box-name">{{name}}</div>
            {{#if bio}}
              <p class="author-box-bio">{{bio}}</p>
            {{else}}
              <p class="author-box-bio">A member of the family.</p>
            {{/if}}
          </div>
        </div>
      </div>
    {{/primary_author}}

    <div class="post-comments">
      {{comments}}
    </div>

  {{else}}
    <div class="post-access-wall fade-up">
      <div class="post-access-wall-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
          <path d="M7 11V7a5 5 0 0110 0v4"/>
        </svg>
      </div>
      <h2>Family members only</h2>
      <p>
        This story is shared privately within the my family.
        Sign in with your family account to read it.
      </p>
      <a href="/#/portal/signin" class="btn-primary">Sign in to read →</a>
    </div>
  {{/if}}

  <a href="/write/edit/{{id}}" class="edit-post-btn" id="edit-post-btn" title="Edit this post" style="display:none">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
    Edit post
  </a>
  <script>
  (function() {
    fetch('/members/api/member/')
      .then(function(r) { return r.ok ? r.json() : null; })
      .then(function(m) {
        if (m && Array.isArray(m.labels) && m.labels.some(function(l) {
          return l.name.toLowerCase() === 'writer';
        })) {
          var btn = document.getElementById('edit-post-btn');
          if (btn) btn.style.display = '';
        }
      })
      .catch(function() {});
  })();
  </script>

</article>
{{/post}}

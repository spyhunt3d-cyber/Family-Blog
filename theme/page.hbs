{{!< default}}

<article class="gh-article {{post_class}}">

  {{! @page.show_title_and_feature_image — required by Ghost 5 beta editor }}
  {{#match @page.show_title_and_feature_image}}
    <header class="post-header fade-up">
      <h1 class="post-header-title">{{title}}</h1>
    </header>

    {{#if feature_image}}
      <div class="post-feature-image fade-up">
        <img src="{{img_url feature_image size="l"}}" alt="{{title}}">
      </div>
    {{/if}}
  {{/match}}

  <section class="post-content gh-content fade-up">
    {{content}}
  </section>

</article>

# Ghost Blog — Environment Variables
# Copy to .env and fill in your values. Never commit .env.

# Public URL of your Ghost blog (e.g. https://blog.example.com)
GHOST_URL=https://blog.example.com

# Ghost content directory on the host
GHOST_CONTENT_PATH=/path/to/ghost-content

# MySQL data directory on the host
MYSQL_DATA_PATH=/path/to/mysql-data

# Database credentials
MYSQL_ROOT_PASSWORD=changeme
GHOST_DB_PASSWORD=changeme

# Mail — "From" address shown on invite/reset emails
# Format: "'Blog Name' <noreply@example.com>"
GHOST_MAIL_FROM="'My Blog' <noreply@example.com>"

# Docker network name (must already exist: docker network create my-net)
DOCKER_NETWORK=my-net

# Mailgun SMTP credentials
MAILGUN_SMTP_USER=postmaster@mg.example.com
MAILGUN_SMTP_PASSWORD=changeme

# Ghost Writer — Environment Variables
# Copy to .env and fill in your values. Never commit .env.

# Public URL of your Ghost blog (e.g. https://blog.example.com)
GHOST_URL=https://blog.example.com

# Hostname only (no scheme), used for the session cookie domain
GHOST_COOKIE_DOMAIN=blog.example.com

# Ghost Admin API key (Staff → Integrations → Add custom integration)
GHOST_ADMIN_API_KEY=changeme

# Secret for signing session cookies — use a long random string
SESSION_SECRET=changeme

# Absolute path to the ghost-writer/app directory on the host
GHOST_WRITER_APP_PATH=/path/to/ghost-writer/app

# LAN IP of the host running Ghost (for extra_hosts resolution)
HOST_LAN_IP=192.168.1.1

# Hostname of Ghost blog (without scheme), matches GHOST_URL host
GHOST_HOST=blog.example.com

# Docker network name
DOCKER_NETWORK=my-net
